# Database Configuration (SQLite default for local dev; LibSQL / Turso compatible)
DATABASE_URL="file:./dev.db"
# TURSO_AUTH_TOKEN="" # Optional: for Turso cloud SQLite

# NextAuth.js Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="devconnect-super-secret-jwt-key-2026-safe-production-32chars!"

# Google OAuth (Optional - Credentials email/password login works out of the box)
GOOGLE_CLIENT_ID=""
